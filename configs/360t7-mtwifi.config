# Target
CONFIG_TARGET_mt798x=y
CONFIG_TARGET_mt798x_mt7981=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qihoo_360t7=y
# 关键：启用MTK闭源mtwifi驱动（不要mt76）
CONFIG_PACKAGE_kmod-mtwifi=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-mtk=y
# HNAT硬件加速
CONFIG_PACKAGE_kmod-hnat=y
CONFIG_PACKAGE_luci-app-hnat=y
# 分区选择：原厂36M分区；想要108M大分区就开启下面一行
CONFIG_TARGET_DEVICE_qihoo_360t7_108m=y
# 基础LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 可选插件，按需增减
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
